<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Breathing animation circles background -->
    <item android:drawable="@drawable/splash_breathing_animation"
          android:width="200dp"
          android:height="200dp"
          android:gravity="center" />
    
    <!-- App icon visibility background - subtle but effective -->
    <item android:width="118dp"
          android:height="118dp"
          android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
            <stroke 
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>
    
    <!-- Main app icon -->
    <item android:drawable="@mipmap/ic_launcher"
          android:width="108dp"
          android:height="108dp"
          android:gravity="center" />
</layer-list>