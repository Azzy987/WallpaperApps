<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    
    <aapt:attr name="android:drawable">
        <vector
            android:width="200dp"
            android:height="200dp"
            android:viewportWidth="200"
            android:viewportHeight="200">
            
            <!-- Outer breathing circle -->
            <group android:name="outerCircleGroup"
                   android:pivotX="100"
                   android:pivotY="100">
                <path
                    android:name="outerCirclePath"
                    android:pathData="M100,30 A70,70 0 1,1 99.9,30 z"
                    android:fillColor="#1A000000" />
            </group>
            
            <!-- Middle breathing circle -->
            <group android:name="middleCircleGroup"
                   android:pivotX="100"  
                   android:pivotY="100">
                <path
                    android:name="middleCirclePath"
                    android:pathData="M100,40 A60,60 0 1,1 99.9,40 z"
                    android:fillColor="#26FFFFFF" />
            </group>
            
            <!-- Inner breathing circle -->
            <group android:name="innerCircleGroup"
                   android:pivotX="100"
                   android:pivotY="100">
                <path
                    android:name="innerCirclePath"
                    android:pathData="M100,50 A50,50 0 1,1 99.9,50 z"
                    android:fillColor="#33FFFFFF" />
            </group>
        </vector>
    </aapt:attr>
    
    <!-- Outer circle breathing animation -->
    <target android:name="outerCircleGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="2200"
                    android:valueFrom="0.8"
                    android:valueTo="1.2"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="2200"
                    android:valueFrom="0.8"
                    android:valueTo="1.2"  
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:duration="2200"
                    android:valueFrom="0.3"
                    android:valueTo="0.7"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- Middle circle breathing animation -->
    <target android:name="middleCircleGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="2000"
                    android:valueFrom="0.7"
                    android:valueTo="1.1"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="2000"
                    android:valueFrom="0.7"
                    android:valueTo="1.1"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:duration="2000"
                    android:valueFrom="0.4"
                    android:valueTo="0.8"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
    
    <!-- Inner circle breathing animation -->
    <target android:name="innerCircleGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="1800"
                    android:valueFrom="0.9"
                    android:valueTo="1.0"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="1800"
                    android:valueFrom="0.9"
                    android:valueTo="1.0"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:duration="1800"
                    android:valueFrom="0.6"
                    android:valueTo="1.0"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>