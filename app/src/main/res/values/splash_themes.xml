<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme for Android 12+ (Light) -->
    <style name="Theme.WallpaperApp.Splash" parent="Theme.SplashScreen">
        <!-- Background color for splash screen -->
        <item name="android:windowSplashScreenBackground">@drawable/splash_background_light</item>
        <!-- Animated icon for splash screen -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <!-- Duration to keep splash screen visible -->
        <item name="android:windowSplashScreenAnimationDuration">2000</item>
        <!-- Icon background color (transparent to show breathing animation) -->
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- Fallback for older Android versions -->
        <item name="android:windowBackground">@drawable/splash_background_light</item>
        <!-- Post-splash theme to transition to -->
        <item name="postSplashScreenTheme">@style/Theme.WallpaperApp</item>
    </style>
</resources>