<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme for Android 12+ (Dark) -->
    <style name="Theme.WallpaperApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@drawable/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">1500</item>
        <item name="android:windowBackground">@drawable/splash_background_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.WallpaperApp</item>
    </style>
</resources>