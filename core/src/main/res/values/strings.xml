    <!-- Depth Effect Instructions -->
    <string name="depth_effect_title">Depth Effect Instructions</string>
    <string name="depth_effect_description">Depth Effect wallpapers are specially designed to create a 3D effect when set as your lock screen. Follow these steps:</string>
    <string name="depth_effect_step1">1. Download and save the wallpaper or click \'Apply\' and then \'External\'.</string>
    <string name="depth_effect_step2">2. Go to your phone\'s Settings > Wallpaper &amp; Style.</string>
    <string name="depth_effect_step3">3. Select the wallpaper and set it as your Lock Screen.</string>
    <string name="depth_effect_step4">4. Make sure the \'Depth Effect\' option is enabled during setup.</string>
    <string name="depth_effect_note">Note: Depth Effect works best on %1$s series phones.</string>
    <string name="depth_effect_tip">For optimal results, keep your screen clean and avoid using screen protectors that may interfere with the depth sensors.</string>

